        </mxCell>
        <mxCell id="K3Cq0NS5Ez0eySLGd8pS-127" edge="1" parent="1" source="detailstr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" target="K3Cq0NS5Ez0eySLGd8pS-107">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="detailstr" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#000000;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Details&lt;br&gt;= 4&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="120" x="1440" y="89" as="geometry" />
        </mxCell>
        <mxCell id="lg_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFB;strokeColor=#9E9E9E;verticalAlign=top;align=center;" value="" vertex="1">
          <mxGeometry height="1360" width="700" x="1780" y="40" as="geometry" />
        </mxCell>
        <mxCell id="lg_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" value="ЛЕГЕНДА — что делает каждый блок (вход → действие → выход)" vertex="1">
          <mxGeometry height="34" width="660" x="1800" y="55" as="geometry" />
        </mxCell>
        <mxCell id="lg_shapes" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;spacingLeft=6;" value="&lt;b&gt;Обозначения фигур:&lt;/b&gt;  🟥 жёлтый — утилита/обработка  |  ⬜ параллелограмм — данные (промежуточный результат)  |  ◆ серый ромб — условие (уровень детализации)  |  🟢 старт  |  🔵 итог (REPORT)  |  🟠 внешний приёмник (Burp)" vertex="1">
          <mxGeometry height="46" width="660" x="1800" y="94" as="geometry" />
        </mxCell>
        <mxCell id="lg_cat1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#000000;spacingLeft=8;spacingTop=6;fillColor=#EAF5E4;strokeColor=#82B366;rounded=1;" value="&lt;b&gt;1. РАЗВЕДКА (левая колонка)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ROOT DOMAINS&lt;/b&gt; — старт. Вход: корневые домены (-d/-f). Выход: домены для перечисления.&lt;br&gt;&lt;b&gt;Subfinder&lt;/b&gt; — пассивный поиск поддоменов. Вход: корневые домены → Выход: список поддоменов.&lt;br&gt;&lt;b&gt;DNSX&lt;/b&gt; — DNS-резолв и брутфорс поддоменов по словарю. Вход: поддомены → Выход: живые (резолвящиеся) хосты.&lt;br&gt;&lt;b&gt;Naabu&lt;/b&gt; — сканирование портов. Вход: живые хосты/IP → Выход: открытые сетевые сервисы.&lt;br&gt;&lt;b&gt;HTTPX&lt;/b&gt; — проверка живых веб-сервисов и детект WAF/CDN (cdncheck). Вход: сервисы → Выход: Found sites.&lt;br&gt;&lt;b&gt;Hidden hosts search&lt;/b&gt; — доступ к неактивным хостам через подмену Host-заголовка. Вход: старые/мёртвые хосты → Выход: REPORT.&lt;br&gt;&lt;b&gt;Subdomains takeover scan&lt;/b&gt; — проверка захвата поддоменов (Nuclei). Вход: поддомены → Выход: REPORT.&lt;br&gt;&lt;b&gt;Postleaks&lt;/b&gt; — поиск секретов в публичном Postman. Вход: домены/ключевые слова → Выход: REPORT." vertex="1">
          <mxGeometry height="268" width="660" x="1800" y="148" as="geometry" />
        </mxCell>
        <mxCell id="lg_cat2" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#000000;spacingLeft=8;spacingTop=6;fillColor=#FFF4E6;strokeColor=#D79B00;rounded=1;" value="&lt;b&gt;2. КРАУЛИНГ И ЗАВИСИМОСТИ (верх)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Katana&lt;/b&gt; — краулинг/спайдеринг, сбор ссылок и JS. Вход: Found sites → Выход: ссылки (в URO) + JS-библиотеки/манифесты (в Dependency check).&lt;br&gt;&lt;b&gt;URO&lt;/b&gt; — нормализация и дедупликация URL. Вход: ссылки от Katana → Выход: Crawled links.&lt;br&gt;&lt;b&gt;Dependency check&lt;/b&gt; — confused + osv-scanner: dependency confusion, утёкшие манифесты, CVE. Вход: JS-библиотеки (из Katana/JS links) и манифесты зависимостей (запрашиваются с хостов) → Выход: REPORT." vertex="1">
          <mxGeometry height="150" width="660" x="1800" y="424" as="geometry" />
        </mxCell>
        <mxCell id="lg_cat3" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#000000;spacingLeft=8;spacingTop=6;fillColor=#F2F2F2;strokeColor=#999999;rounded=1;" value="&lt;b&gt;3. ДАННЫЕ (параллелограммы — промежуточные результаты)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Found sites&lt;/b&gt; — живые веб-ресурсы → в Katana и CDNcheck.&lt;br&gt;&lt;b&gt;Hosts with / without WAF&lt;/b&gt; — активы, разделённые по наличию WAF → в LeakIX, WAF bypass, Nuclei config/default, Details.&lt;br&gt;&lt;b&gt;Crawled links&lt;/b&gt; — нормализованные URL → в Links with/without WAF, JS links, Feroxbuster, Social links check.&lt;br&gt;&lt;b&gt;Links on hosts with / without WAF&lt;/b&gt; — собранные ссылки, разбитые по WAF → в Details и Burp Suite.&lt;br&gt;&lt;b&gt;JS links&lt;/b&gt; — найденные JS-файлы → в Nuclei tokens scan и Burp Suite." vertex="1">
          <mxGeometry height="196" width="660" x="1800" y="582" as="geometry" />
        </mxCell>
        <mxCell id="lg_cat4" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#000000;spacingLeft=8;spacingTop=6;fillColor=#FFF8E1;strokeColor=#BF9000;rounded=1;" value="&lt;b&gt;4. АКТИВНЫЕ ПРОВЕРКИ (центр/право)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;LeakIX&lt;/b&gt; — внешняя разведка по открытым источникам. Вход: хосты → Выход: REPORT.&lt;br&gt;&lt;b&gt;WAF bypass&lt;/b&gt; — попытки обхода WAF к origin-серверу (хосты с WAF проверяются через хосты без WAF). Вход: хосты с WAF + хосты без WAF → Выход: REPORT.&lt;br&gt;&lt;b&gt;Nuclei config scan&lt;/b&gt; — поиск открытых конфигов/exposure. Вход: хосты с WAF и без WAF (всегда оба) → Выход: REPORT.&lt;br&gt;&lt;b&gt;Nuclei default scan&lt;/b&gt; — скан уязвимостей. Вход: хосты без WAF (+ за WAF при -ld 4) → Выход: REPORT.&lt;br&gt;&lt;b&gt;Feroxbuster&lt;/b&gt; — фаззинг директорий и файлов. Вход: хосты без WAF (+ за WAF при -ld 4) → Выход: Byp4xx, Burp, REPORT.&lt;br&gt;&lt;b&gt;Byp4xx&lt;/b&gt; — обход ответов 40X (403/401). Вход: найденные 40X → Выход: REPORT.&lt;br&gt;&lt;b&gt;Social links check&lt;/b&gt; — захват брошенных соцсетей. Вход: Crawled links → Выход: REPORT.&lt;br&gt;&lt;b&gt;Nuclei tokens scan&lt;/b&gt; — поиск токенов/секретов в JS. Вход: JS links → Выход: REPORT.&lt;br&gt;&lt;b&gt;Nuclei DAST scan&lt;/b&gt; — динамический скан (фаззинг параметров). Вход: ссылки без WAF (всегда, если нет -dd) + ссылки за WAF (при -ld 4) → Выход: REPORT." vertex="1">
          <mxGeometry height="304" width="660" x="1800" y="786" as="geometry" />
        </mxCell>
        <mxCell id="lg_cat5" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#000000;spacingLeft=8;spacingTop=6;fillColor=#EDE7F6;strokeColor=#9673A6;rounded=1;" value="&lt;b&gt;5. УСЛОВИЯ И ПРИЁМНИКИ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Details = 4&lt;/b&gt; (серый ромб) — уровень детализации (-ld). Ветка «Yes» срабатывает при -ld 4 (WAF-фильтрация выключена): в Nuclei default scan, Feroxbuster и Nuclei DAST scan ДОПОЛНИТЕЛЬНО подаются активы и ссылки, находящиеся за WAF.&lt;br&gt;&lt;b&gt;Burp Suite&lt;/b&gt; — внешний приёмник: получает эндпоинты/ссылки для ручного анализа (флаги -ba/-bw/-bf/-bb).&lt;br&gt;&lt;b&gt;REPORT&lt;/b&gt; — финальный приёмник: агрегирует все находки в единый HTML/Markdown-отчёт." vertex="1">
          <mxGeometry height="150" width="660" x="1800" y="1098" as="geometry" />
        </mxCell>
        <mxCell id="K3Cq0NS5Ez0eySLGd8pS-19" edge="1" parent="1" source="K3Cq0NS5Ez0eySLGd8pS-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" target="K3Cq0NS5Ez0eySLGd8pS-18">
